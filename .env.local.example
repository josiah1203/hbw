# HBW local dev — M4-local tier (no Docker)
# Copy: cp .env.local.example .env.local
#
# 1. Start API (from hb-platform sibling layout):
#      cd ../hbp-cloud && ./scripts/dev-local.sh
#    Health: curl -sf http://localhost:8000/health/live
#
# 2. Obtain access token via hb CLI:
#      cd ../hb
#      python3 -m hb.main auth login \
#        --api-url http://localhost:8000 \
#        --email admin@dev.hbp \
#        --password devpassword \
#        --json
#    Copy access_token into VITE_HBP_ACCESS_TOKEN below (or use --save and
#    paste from ~/.config/hb/config.json).
#
# Seeded dev user/project come from hbp-cloud/scripts/seed_dev.py (admin@dev.hbp).

VITE_HBP_API_URL=http://localhost:8000
VITE_HBP_ACCESS_TOKEN=
